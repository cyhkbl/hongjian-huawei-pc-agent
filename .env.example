# Copy to .env for local runs. NEVER commit a real .env.

# ---- ima OpenAPI (create at https://ima.qq.com/agent-interface with the account that joined the shared KB)
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# IMA_KB_NAME=任德耀新建华为PC知识库

# ---- KB mode: auto | ima | local
KB_MODE=auto
# Local mirror of the organiser's KB (dev only, never commit it)
# KB_LOCAL_DIR=D:\path\to\华为PC全板块深度知识库_v7

# ---- Public LLM, any OpenAI-compatible /chat/completions endpoint (optional;
#      empty => deterministic composer, the pipeline still works end to end)
# LLM_BASE_URL=https://api-inference.modelscope.cn/v1
# LLM_API_KEY=
# LLM_MODEL=

HOST=0.0.0.0
PORT=7860
